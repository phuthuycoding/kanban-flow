#!/usr/bin/env bash
# Write a review package — commit list, stat summary and the net diff with extended
# context — to one file a reviewer reads in a single call, so the diff never passes
# through the orchestrator's context.
#
# Usage: review-package BASE HEAD OUTFILE [--untracked]
#   BASE      the commit the work started from (the ## Baseline of tasks.md, or the
#             task's recorded BASE); never HEAD~1, which truncates multi-commit work
#   HEAD      the commit to review up to (usually HEAD)
#   OUTFILE   where to write; the parent directory is created
#   --untracked  also append untracked, non-ignored files whole — they are invisible
#             to `git diff` and a worktree under review may still hold them
#
# Exit 2: bad arguments. Exit 3: HEAD is not a descendant of BASE, or the range is
# empty and nothing is untracked (a wrong branch, or an implementer that committed
# nothing — send it back; DONE requires a commit).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package BASE HEAD OUTFILE [--untracked]" >&2
  exit 2
fi

base=$1
head=$2
out=$3
untracked=0
[ "${4:-}" = "--untracked" ] && untracked=1

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }
git merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }

commits=$(git rev-list --count "${base}..${head}")
new=""
if [ "$untracked" = "1" ]; then
  new=$(git -c core.quotePath=false ls-files --others --exclude-standard)
fi
if [ "$commits" -eq 0 ] && [ -z "$new" ]; then
  echo "empty commit range: ${base}..${head} (and nothing untracked)" >&2
  exit 3
fi

mkdir -p "$(dirname "$out")"
{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
  if [ -n "$new" ]; then
    echo
    echo "## Untracked new files (whole)"
    printf '%s\n' "$new" | while IFS= read -r f; do
      [ -f "$f" ] || continue
      echo
      echo "### $f"
      cat -- "$f"
    done
  fi
} > "$out"

echo "wrote ${out}: ${commits} commit(s), $(printf '%s\n' "$new" | grep -c . || true) untracked file(s), $(wc -c < "$out" | tr -d ' ') bytes"
