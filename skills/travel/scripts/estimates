#!/usr/bin/env node
// Travel estimates: T-shirt sizes, the measurement ledger, the daily budget and the dispatch rule.
//
// Usage:
//   estimates size <minutes> <files> [<estimates.md> <kind>]
//       line 1 = S|M|L|XL; line 2 = points: <1|2|4|8> (XL adds "(should split)");
//       line 3 = defaults (<n> <kind> rows with estmin) | learned: <m> min × <factor> = <m'> min (<kind>, last <n> rows)
//   estimates measure --file <estimates.md> --id <id> --feature <f> --kind <kind> --est <S|M|L|XL> [--estmin <minutes>]
//                     --work <minutes> --review <minutes> --files <n> --rounds <n> --path <a→b> --tier <tier>
//                     [--date YYYY-MM-DD] [--cancelled]
//       appends one row and prints it; --cancelled records `actual -` and `gap -` (excluded from stats)
//   estimates stats <estimates.md>
//       budget, hit rate, bias, throughput, calibration, per-kind hit rate / bias / factor, week-over-week warning
//   estimates overlap <filesA> <filesB>
//       sequential | parallel — comma-separated plan `Files` cells; an empty cell means unknown files (sequential)
//
// A missing estimates.md means no history yet. Bad input exits 1 with a message.
//
// Written without import/export statements so it runs whatever module type the surrounding package.json declares.
"use strict";

const SIZES = ["S", "M", "L", "XL"];
const POINTS = { S: 1, M: 2, L: 4, XL: 8 };
const HEADER = "date · id · feature · kind · est · actual · work · review · files · rounds · path · tier · gap · estmin";
const FIELDS = HEADER.split(" · ");
// Rows written before estmin existed (and measure without --estmin) end at gap; they are kept but teach nothing.
const OLD_HEADER = FIELDS.slice(0, -1).join(" · ");
const SEP = " · ";
const LEARN_FLOOR = 20;
// About two weeks of rows at a few items a day: recent enough to follow a change in agent speed, and the median of
// that many ratios is not moved by one stuck run.
const LEARN_WINDOW = 30;
// The default minute bands grow about ×3–4 (5 → 20 → 60), so ×3 moves an estimate up at most about one size.
// Downward is capped tighter because an estimate shrunk too far overfills the day's budget.
const FACTOR_MIN = 0.5;
const FACTOR_MAX = 3;
const DEFAULT_TASKS = 10;
const MIN_DAYS = 3;
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;

class InputError extends Error {}

// DATE_RE alone lets 2026-13-40 through, and Date.parse turns it into NaN downstream.
function realDate(s) {
  if (!DATE_RE.test(s)) return false;
  const t = Date.parse(`${s}T00:00:00Z`);
  return !Number.isNaN(t) && new Date(t).toISOString().slice(0, 10) === s;
}

function fail(message) {
  throw new InputError(message);
}

function number(name, raw, integer) {
  if (raw === undefined || raw === "" || !/^\d+(\.\d+)?$/.test(String(raw))) fail(`${name} must be a non-negative number: ${raw ?? "(missing)"}`);
  const n = Number(raw);
  if (integer && !Number.isInteger(n)) fail(`${name} must be a whole number: ${raw}`);
  return n;
}

// Inclusive upper bounds per size; S minutes is strict (< 5) in the defaults.
const DEFAULT_RULE = {
  S: { minutes: (m) => m < 5, files: (f) => f <= 3 },
  M: { minutes: (m) => m <= 20, files: (f) => f <= 10 },
  L: { minutes: (m) => m <= 60, files: (f) => f <= 30 },
};

function sizeBy(test, value, rule) {
  for (const s of ["S", "M", "L"]) if (rule[s][test](value)) return s;
  return "XL";
}

function higher(a, b) {
  return SIZES.indexOf(a) >= SIZES.indexOf(b) ? a : b;
}

function sizeOf(minutes, files, rule) {
  return higher(sizeBy("minutes", minutes, rule), sizeBy("files", files, rule));
}

function parseRows(text, file) {
  const rows = [];
  text.split(/\r?\n/).forEach((line, i) => {
    const trimmed = line.trim();
    if (trimmed === "" || trimmed.startsWith("#") || trimmed === HEADER || trimmed === OLD_HEADER) return;
    const cells = line.split(SEP).map((c) => c.trim());
    if (cells.length !== FIELDS.length && cells.length !== FIELDS.length - 1) {
      fail(`${file}:${i + 1}: expected ${FIELDS.length} fields (${HEADER}), or ${FIELDS.length - 1} without estmin, got ${cells.length}`);
    }
    const row = Object.fromEntries(FIELDS.map((f, k) => [f, cells[k]]));
    if (!realDate(row.date)) fail(`${file}:${i + 1}: date must be a real YYYY-MM-DD day: ${row.date}`);
    if (!SIZES.includes(row.est)) fail(`${file}:${i + 1}: est must be S|M|L|XL: ${row.est}`);
    if (row.actual !== "-" && !SIZES.includes(row.actual)) fail(`${file}:${i + 1}: actual must be S|M|L|XL or -: ${row.actual}`);
    row.measured = row.actual !== "-";
    if (row.measured) {
      row.workMin = number(`${file}:${i + 1}: work`, row.work, false);
      row.fileCount = number(`${file}:${i + 1}: files`, row.files, true);
    }
    if (row.estmin !== undefined) row.estMin = positive(`${file}:${i + 1}: estmin`, row.estmin);
    rows.push(row);
  });
  return rows;
}

async function loadRows(file) {
  const { existsSync, readFileSync } = await import("node:fs");
  if (!file || !existsSync(file)) return [];
  return parseRows(readFileSync(file, "utf8"), file);
}

function positive(name, raw) {
  const n = number(name, raw, false);
  if (n === 0) fail(`${name} must be above 0: ${raw}`);
  return n;
}

// The minutes correction for one kind: the median of work ÷ estmin over its last LEARN_WINDOW measured rows.
// Its inputs are the agent's raw estimate and the measured work — neither is ever computed from the factor, so the
// factor cannot feed on itself; a ratio above 1 corrects estimates up, below 1 down.
function factorFor(rows, kind) {
  const usable = rows.filter((r) => r.measured && r.kind === kind && r.estMin !== undefined);
  if (usable.length < LEARN_FLOOR) return { usable: usable.length, factor: 1, raw: null, window: 0 };
  const window = usable.slice(-LEARN_WINDOW);
  const raw = median(window.map((r) => r.workMin / r.estMin));
  return { usable: usable.length, factor: Math.min(FACTOR_MAX, Math.max(FACTOR_MIN, raw)), raw, window: window.length };
}

function factorText(f) {
  return f.factor === f.raw ? fmt2(f.factor) : `${fmt2(f.factor)} (clamped from ${fmt2(f.raw)})`;
}

async function cmdSize(args) {
  if (args.length !== 2 && args.length !== 4) fail("usage: estimates size <minutes> <files> [<estimates.md> <kind>]");
  const minutes = number("minutes", args[0], false);
  const files = number("files", args[1], true);
  let corrected = minutes;
  let text = "defaults (0 rows measured)";
  if (args.length === 4) {
    const kind = args[3];
    if (kind === "") fail("kind must not be empty");
    const f = factorFor(await loadRows(args[2]), kind);
    if (f.raw === null) text = `defaults (${f.usable} ${kind} rows with estmin)`;
    else {
      corrected = minutes * f.factor;
      text = `learned: ${fmt(minutes)} min × ${factorText(f)} = ${fmt(corrected)} min (${kind}, last ${f.window} rows)`;
    }
  }
  // Always the default thresholds, the same rule measure sizes actual with, so est and actual compare like with like.
  const size = sizeOf(corrected, files, DEFAULT_RULE);
  return [size, `points: ${POINTS[size]}${size === "XL" ? " (should split)" : ""}`, text];
}

function parseFlags(args) {
  const flags = {};
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (!a.startsWith("--")) fail(`unexpected argument: ${a}`);
    const key = a.slice(2);
    if (key === "cancelled") { flags.cancelled = true; continue; }
    const value = args[i + 1];
    if (value === undefined || value.startsWith("--")) fail(`--${key} needs a value`);
    flags[key] = value;
    i++;
  }
  return flags;
}

function today() {
  const d = new Date();
  const pad = (n) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

function cell(name, value) {
  if (value === undefined || value === "") fail(`--${name} is required`);
  if (value.includes(" · ") || /[\r\n]/.test(value)) fail(`--${name} must not contain " · " or a newline: ${value}`);
  return value;
}

async function cmdMeasure(args) {
  const known = new Set(["file", "id", "feature", "kind", "est", "estmin", "work", "review", "files", "rounds", "path", "tier", "date", "cancelled"]);
  const f = parseFlags(args);
  for (const k of Object.keys(f)) if (!known.has(k)) fail(`unknown flag --${k}`);
  const file = cell("file", f.file);
  const est = cell("est", f.est);
  if (!SIZES.includes(est)) fail(`--est must be S|M|L|XL: ${est}`);
  const estmin = f.estmin === undefined ? undefined : positive("--estmin", f.estmin);
  const work = number("--work", f.work, false);
  const review = number("--review", f.review, false);
  const files = number("--files", f.files, true);
  const rounds = number("--rounds", f.rounds, true);
  const kind = cell("kind", f.kind);
  if (!["feature", "bug", "pr"].includes(kind)) fail(`--kind must be feature|bug|pr: ${kind}`);
  const date = f.date === undefined ? today() : f.date;
  if (!realDate(date)) fail(`--date must be YYYY-MM-DD: ${date}`);
  // Parsed only to refuse appending to a malformed file.
  await loadRows(file);
  let actual = "-";
  let gap = "-";
  if (!f.cancelled) {
    actual = sizeOf(work, files, DEFAULT_RULE);
    const d = SIZES.indexOf(actual) - SIZES.indexOf(est);
    gap = d > 0 ? `+${d}` : String(d);
  }
  const line = [date, cell("id", f.id), cell("feature", f.feature), kind, est, actual,
    String(work), String(review), String(files), String(rounds), cell("path", f.path), cell("tier", f.tier), gap,
    ...(estmin === undefined ? [] : [String(estmin)])].join(SEP);
  const { existsSync, readFileSync, appendFileSync, writeFileSync, mkdirSync } = await import("node:fs");
  const { dirname } = await import("node:path");
  if (!existsSync(file) || readFileSync(file, "utf8").trim() === "") {
    mkdirSync(dirname(file), { recursive: true });
    writeFileSync(file, `# Travel estimates\n\n${HEADER}\n`);
  }
  const current = readFileSync(file, "utf8");
  appendFileSync(file, `${current.endsWith("\n") || current === "" ? "" : "\n"}${line}\n`);
  return [line];
}

function median(values) {
  const s = [...values].sort((a, b) => a - b);
  const mid = Math.floor(s.length / 2);
  return s.length % 2 === 1 ? s[mid] : (s[mid - 1] + s[mid]) / 2;
}

function fmt(n) {
  return Number.isInteger(n) ? String(n) : n.toFixed(1);
}

function fmt2(n) {
  return String(Number(n.toFixed(2)));
}

function dayNumber(date) {
  return Math.floor(Date.parse(`${date}T00:00:00Z`) / 86400000);
}

function hits(rows) {
  return rows.filter((r) => r.est === r.actual).length;
}

async function cmdStats(args) {
  if (args.length !== 1) fail("usage: estimates stats <estimates.md>");
  const rows = await loadRows(args[0]);
  const measured = rows.filter((r) => r.measured);
  const byDay = new Map();
  for (const r of measured) byDay.set(r.date, (byDay.get(r.date) ?? 0) + POINTS[r.actual]);
  const days = [...byDay.keys()].sort();
  const totals = days.map((d) => byDay.get(d));
  const total = totals.reduce((a, b) => a + b, 0);
  const out = [];
  if (days.length >= MIN_DAYS) out.push(`budget: ${fmt(median(totals))} points (median of ${days.length} days)`);
  else out.push(`budget: ${DEFAULT_TASKS} tasks (default — fewer than ${MIN_DAYS} days measured)`);
  out.push(`hit rate: ${hits(measured)}/${measured.length}`);
  const over = measured.filter((r) => SIZES.indexOf(r.est) > SIZES.indexOf(r.actual)).length;
  const under = measured.filter((r) => SIZES.indexOf(r.est) < SIZES.indexOf(r.actual)).length;
  out.push(`bias: ${over} over, ${under} under`);
  out.push(`throughput: ${total} points / ${days.length} days`);
  out.push(days.length >= MIN_DAYS
    ? `calibration: budget = median daily actual points of ${days.map((d) => `${d} (${byDay.get(d)})`).join(", ")}`
    : "calibration: none yet");
  const kinds = [...new Set(measured.map((r) => r.kind))].sort();
  for (const k of kinds) {
    const same = measured.filter((r) => r.kind === k);
    const bias = same.reduce((a, r) => a + SIZES.indexOf(r.actual) - SIZES.indexOf(r.est), 0) / same.length;
    const f = factorFor(rows, k);
    const factor = f.raw === null ? `factor 1 (defaults — ${f.usable} rows with estmin, needs ${LEARN_FLOOR})`
      : `factor ${factorText(f)} (median of last ${f.window} rows)`;
    out.push(`kind ${k}: hit rate ${hits(same)}/${same.length}, bias ${bias > 0 ? "+" : ""}${bias.toFixed(1)} sizes, ${factor}`);
  }
  if (days.length > 0) {
    const last = dayNumber(days[days.length - 1]);
    const thisWeek = measured.filter((r) => last - dayNumber(r.date) <= 6);
    const lastWeek = measured.filter((r) => { const age = last - dayNumber(r.date); return age >= 7 && age <= 13; });
    if (thisWeek.length > 0 && lastWeek.length > 0 && hits(thisWeek) / thisWeek.length < hits(lastWeek) / lastWeek.length) {
      out.push(`warning: hit rate fell — this week ${hits(thisWeek)}/${thisWeek.length}, last week ${hits(lastWeek)}/${lastWeek.length}`);
    }
  }
  return out;
}

// `[` is deliberately not a glob character: Files lists real paths such as `src/[id].ts`, and the matcher has no bracket classes.
const GLOB_CHARS = /[*?]/;

function normalise(pattern) {
  let p = pattern.replace(/`/g, "").trim();
  while (p.startsWith("./")) p = p.slice(2);
  while (p.length > 1 && p.endsWith("/")) p = p.slice(0, -1);
  return p;
}

function matchesAll(p) {
  return p === "**" || p === "*" || p === "." || p === "";
}

// The directory part fixed before the first glob character, segment-aligned.
function staticPrefix(p) {
  const at = p.search(GLOB_CHARS);
  if (at === -1) return p;
  const head = p.slice(0, at);
  return head.slice(0, head.lastIndexOf("/") + 1).replace(/\/+$/, "");
}

function isPathPrefix(prefix, path) {
  return prefix === "" || path === prefix || path.startsWith(`${prefix}/`);
}

// Mirrors patternsOverlap/filesOverlap in src/workflow/allowlist.ts (skill scripts cannot import the TS); keep them in sync.
function patternsOverlap(a, b) {
  const x = normalise(a);
  const y = normalise(b);
  if (x === y || matchesAll(x) || matchesAll(y)) return true;
  const px = staticPrefix(x);
  const py = staticPrefix(y);
  return isPathPrefix(px, py) || isPathPrefix(py, px);
}

function filesCell(raw) {
  const list = raw.split(",").map((s) => s.replace(/`/g, "").trim()).filter((s) => s !== "");
  return list.length === 0 ? null : list;
}

function cmdOverlap(args) {
  if (args.length !== 2) fail("usage: estimates overlap <filesA> <filesB>");
  const a = filesCell(args[0]);
  const b = filesCell(args[1]);
  if (a === null || b === null) return ["sequential"];
  return [a.some((x) => b.some((y) => patternsOverlap(x, y))) ? "sequential" : "parallel"];
}

const COMMANDS = { size: cmdSize, measure: cmdMeasure, stats: cmdStats, overlap: cmdOverlap };

(async () => {
  const [cmd, ...rest] = process.argv.slice(2);
  const run = COMMANDS[cmd];
  if (!run) fail(`usage: estimates size|measure|stats|overlap … (got ${cmd ?? "nothing"})`);
  const lines = await run(rest);
  process.stdout.write(`${lines.join("\n")}\n`);
})().catch((err) => {
  if (err instanceof InputError) {
    process.stderr.write(`estimates: ${err.message}\n`);
  } else {
    process.stderr.write(`estimates: ${err && err.stack ? err.stack : String(err)}\n`);
  }
  process.exit(1);
});
