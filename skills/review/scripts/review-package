#!/usr/bin/env bash
# Write a review package — commit list, stat summary and the net diff with extended
# context — to one file a reviewer reads in a single call, so the diff never passes
# through the orchestrator's context.
#
# Usage: review-package BASE HEAD OUTFILE [--untracked] [-- <pathspec>...]
#        review-package --commits <sha>[,<sha>...] OUTFILE [-- <pathspec>...]
#   BASE         the commit the work started from (the ## Baseline of tasks.md, or the
#                task's recorded BASE); never HEAD~1, which truncates multi-commit work
#   HEAD         the commit to review up to (usually HEAD)
#   OUTFILE      where to write; the parent directory is created
#   --untracked  also append untracked, non-ignored text files — they are invisible to
#                `git diff` and a worktree under review may still hold them. Symlinks,
#                binaries, files under the kanban work dirs (.works/, .worktrees/) and
#                anything over MAX_LINES lines are skipped or truncated, and listed
#   -- <pathspec>...  limit the package to these paths (one bundle of an oversized diff)
#   --commits    package exactly the listed commits, each diffed against its first parent,
#                in the given order (a commit list, not a range); must be the first
#                argument and cannot be combined with --untracked
#
# Exit 2: bad arguments, or with --commits a sha that is not a commit, a merge or root
# commit, a repeated sha, or --untracked. Exit 3: HEAD is not a descendant of BASE, or the
# range is empty and nothing is untracked (a wrong branch, or an implementer that
# committed nothing — send it back; DONE requires a commit); with --commits, the listed
# commits have an empty diff. Exit 4 (BASE HEAD mode only): tracked files have uncommitted
# changes — the package shows only committed BASE..HEAD while the review's checks see the
# working tree, so the review runs on a committed tree (commit or stop first). --commits
# skips this check: parallel seats share the worktree and their edits are not this package's.
set -euo pipefail

MAX_LINES=400

usage="usage: review-package BASE HEAD OUTFILE [--untracked] [-- <pathspec>...] | review-package --commits <sha>[,<sha>...] OUTFILE [-- <pathspec>...]"

if [ "${1:-}" = "--commits" ]; then
  if [ $# -lt 3 ]; then
    echo "$usage" >&2
    exit 2
  fi
  list=$2
  out=$3
  shift 3
  pathspec=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --untracked) echo "--untracked cannot be used with --commits" >&2; exit 2 ;;
      --) shift; pathspec=("$@"); break ;;
      *) echo "unknown argument: $1 (expected -- <pathspec>)" >&2; exit 2 ;;
    esac
  done

  given=()
  full=()
  rest="${list},"
  while [ -n "$rest" ]; do
    sha=${rest%%,*}
    rest=${rest#*,}
    [ -n "$sha" ] || { echo "bad commit: " >&2; exit 2; }
    resolved=$(git rev-parse --verify --quiet "${sha}^{commit}") || { echo "bad commit: $sha" >&2; exit 2; }
    parents=$(git rev-list --parents -n 1 "$resolved" | wc -w | tr -d ' ')
    [ "$parents" -le 2 ] || { echo "merge commit: $sha" >&2; exit 2; }
    [ "$parents" -ge 2 ] || { echo "root commit: $sha" >&2; exit 2; }
    for seen in ${full[@]+"${full[@]}"}; do
      [ "$seen" != "$resolved" ] || { echo "repeated commit: $sha" >&2; exit 2; }
    done
    given+=("$sha")
    full+=("$resolved")
  done
  [ ${#full[@]} -gt 0 ] || { echo "bad commit: " >&2; exit 2; }

  nonempty=0
  for c in "${full[@]}"; do
    if ! git diff --quiet "${c}^" "$c" -- ${pathspec[@]+"${pathspec[@]}"}; then nonempty=1; fi
  done
  if [ "$nonempty" -eq 0 ]; then
    echo "empty commit list diff: ${list}" >&2
    exit 3
  fi

  shorts=()
  for c in "${full[@]}"; do shorts+=("$(git rev-parse --short=7 "$c")"); done
  mkdir -p "$(dirname "$out")"
  {
    echo "# Review package: commits $(IFS=,; echo "${shorts[*]}")"
    if [ ${#pathspec[@]} -gt 0 ]; then echo "Pathspec: ${pathspec[*]}"; fi
    echo
    echo "## Commits"
    for c in "${full[@]}"; do git log -1 --oneline "$c"; done
    echo
    echo "## Files changed"
    for c in "${full[@]}"; do
      git -c core.quotePath=false diff --name-only "${c}^" "$c" -- ${pathspec[@]+"${pathspec[@]}"}
    done | LC_ALL=C sort -u
    echo
    echo "## Diff"
    for c in "${full[@]}"; do
      git diff -U10 "${c}^" "$c" -- ${pathspec[@]+"${pathspec[@]}"}
    done
  } > "$out"
  echo "wrote ${out}: ${#full[@]} commit(s), 0 untracked file(s) (0 skipped), $(wc -c < "$out" | tr -d ' ') bytes"
  exit 0
fi

if [ $# -lt 3 ]; then
  echo "$usage" >&2
  exit 2
fi

base=$1
head=$2
out=$3
shift 3
untracked=0
pathspec=()
while [ $# -gt 0 ]; do
  case "$1" in
    --untracked) untracked=1; shift ;;
    --) shift; pathspec=("$@"); break ;;
    *) echo "unknown argument: $1 (expected --untracked or -- <pathspec>)" >&2; exit 2 ;;
  esac
done

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }
git merge-base --is-ancestor "$base" "$head" || { echo "HEAD is not a descendant of BASE: ${base}..${head}" >&2; exit 3; }

dirty=0
git diff --quiet HEAD -- || dirty=$?
case "$dirty" in
  0) ;;
  1)
    echo "tracked files have uncommitted changes; the package shows only committed ${base}..${head} — commit them or stop before packaging:" >&2
    git status --porcelain --untracked-files=no >&2
    exit 4
    ;;
  *) echo "git diff HEAD failed (exit ${dirty})" >&2; exit 2 ;;
esac

commits=$(git rev-list --count "${base}..${head}")
new=()
if [ "$untracked" = "1" ]; then
  # NUL-separated so names git would C-quote (quotes, backslashes, tabs, newlines) arrive verbatim.
  listing=$(mktemp)
  trap 'rm -f "$listing"' EXIT
  git ls-files -z --others --exclude-standard -- ${pathspec[@]+"${pathspec[@]}"} > "$listing"
  while IFS= read -r -d '' f; do new+=("$f"); done < "$listing"
fi
if [ "$commits" -eq 0 ] && [ ${#new[@]} -eq 0 ]; then
  echo "empty commit range: ${base}..${head} (and nothing untracked)" >&2
  exit 3
fi

mkdir -p "$(dirname "$out")"
skipped=()
{
  echo "# Review package: ${base}..${head}"
  if [ ${#pathspec[@]} -gt 0 ]; then echo "Pathspec: ${pathspec[*]}"; fi
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}" -- ${pathspec[@]+"${pathspec[@]}"}
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}" -- ${pathspec[@]+"${pathspec[@]}"}
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}" -- ${pathspec[@]+"${pathspec[@]}"}
  if [ ${#new[@]} -gt 0 ]; then
    echo
    echo "## Untracked new files"
    for f in "${new[@]}"; do
      case "$f" in .works/*|.worktrees/*) skipped+=("$f (kanban work dir)"); continue ;; esac
      if [ -L "$f" ]; then skipped+=("$f (symlink)"); continue; fi
      [ -f "$f" ] || { skipped+=("$f (not a regular file)"); continue; }
      if ! grep -Iq . -- "$f" 2>/dev/null; then skipped+=("$f (binary or empty)"); continue; fi
      total=$(wc -l < "$f" | tr -d ' ')
      echo
      echo "### $f"
      if [ "$total" -gt "$MAX_LINES" ]; then
        head -n "$MAX_LINES" -- "$f"
        echo
        echo "[truncated: ${total} lines, first ${MAX_LINES} shown]"
      else
        cat -- "$f"
      fi
    done
    if [ ${#skipped[@]} -gt 0 ]; then
      echo
      echo "### Skipped untracked files (listed by name only)"
      printf -- '- %s\n' "${skipped[@]}"
    fi
  fi
} > "$out"

echo "wrote ${out}: ${commits} commit(s), ${#new[@]} untracked file(s) (${#skipped[@]} skipped), $(wc -c < "$out" | tr -d ' ') bytes"
