{
  "name": "kanban-flow",
  "version": "0.3.0",
  "description": "Kanban workflow CLI — artifact-gated feature pipeline (brainstorm → plan → implement → test → review → archive)",
  "type": "module",
  "license": "MIT",
  "author": "Quyen (phuthuycoding)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phuthuycoding/kanban-flow.git"
  },
  "homepage": "https://github.com/phuthuycoding/kanban-flow#readme",
  "bugs": {
    "url": "https://github.com/phuthuycoding/kanban-flow/issues"
  },
  "keywords": [
    "kanban",
    "workflow",
    "cli",
    "ai-agents",
    "spec-driven",
    "traceability",
    "agentic",
    "code-review",
    "requirements",
    "test-plan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kf": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "docs/workflow",
    "kanban-flow/templates",
    "kanban-flow/review"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/index.js",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "^1.81.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
